#include "Base.xcconfig"

API_SCHEME = http:$(SLASH)$(SLASH)
API_HOST = localhost:8080
API_BASE_URL = $(API_SCHEME)$(API_HOST)/api/v1

SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG

// Required by @testable import. Without it the test target fails with
// "module 'SnapCal' was not compiled for testing". Debug only — never ship a
// Release binary with testability enabled.
ENABLE_TESTABILITY = YES
SWIFT_OPTIMIZATION_LEVEL = -Onone
GCC_OPTIMIZATION_LEVEL = 0
ONLY_ACTIVE_ARCH = YES
CODE_SIGN_STYLE = Automatic
