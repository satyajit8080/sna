<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>SnapCal</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Injected from Debug.xcconfig / Release.xcconfig. No URL is hardcoded in Swift. -->
	<key>API_BASE_URL</key>
	<string>$(API_BASE_URL)</string>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>Background</string>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>

	<!-- Permission strings: each names the feature and what happens to the data. -->
	<key>NSCameraUsageDescription</key>
	<string>SnapCal uses the camera to photograph your meals so it can estimate their calories. Photos are analysed and then discarded — we don't store them.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Choose an existing photo of a meal to log it. SnapCal only reads the photo you pick.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Speak your meal instead of typing it. Audio stays on your device — only the transcribed text is sent.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Turns what you say into a food entry. Transcription runs on your device wherever iOS supports it.</string>

	<key>NSHealthShareUsageDescription</key>
	<string>SnapCal reads your steps, active calories and exercise minutes so your coach can factor in how much you've moved. It never writes to Health.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>SnapCal does not write to Health. This is requested only so iOS can show the Health permission screen.</string>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.snapcal.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>snapcal</string>
			</array>
		</dict>
	</array>

	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<!-- Debug builds only: the Release xcconfig points at an HTTPS host. -->
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
