# Copy to .env for local development. NEVER commit a real .env.
# In production these are Railway service variables, not a file.

# --- AI coach ---
# OpenRouter key: https://openrouter.ai/keys
# Absent => /v1/coach returns 503 and the iOS app shows "coach not set up".
OPENROUTER_API_KEY=

# Model slug from https://openrouter.ai/models — verify the exact string there,
# since slugs change as models are released and retired.
# Kept in the environment so switching models, or routing around a provider
# outage, is a config change rather than a redeploy.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Sent as HTTP-Referer for OpenRouter attribution. Carries no user data.
APP_REFERER=https://bpcoach.app

# --- Food data ---
# Free key: https://fdc.nal.usda.gov/api-key-signup.html
USDA_FDC_API_KEY=

# --- Networking ---
# Comma-separated browser origins. Leave empty for native-app-only traffic:
# iOS sends no Origin header and is always allowed.
CORS_ORIGINS=

RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MINUTES=15

# Railway injects PORT. Only set this locally.
PORT=8080
