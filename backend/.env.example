# ─── runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# ─── database (Railway injects this automatically when you add PostgreSQL) ───
DATABASE_URL=postgresql://user:pass@host:5432/railway

# Migrations run at boot behind an advisory lock. Set false to run them only via
# `npm run migrate` in a Railway one-off command.
RUN_MIGRATIONS_ON_BOOT=true

# ─── auth ────────────────────────────────────────────────────────────────────
# 32+ bytes. Generate: openssl rand -base64 48
JWT_SECRET=

# ─── AI ──────────────────────────────────────────────────────────────────────
AI_PROVIDER=openai                 # openai | gemini | mock
AI_MODEL=gpt-5.6-luna
AI_ESCALATION_MODEL=gpt-5.6-terra
AI_CONFIDENCE_FLOOR=0.55
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=1

# SERVER ONLY. Never appears in the iOS binary.
OPENAI_API_KEY=
GEMINI_API_KEY=                    # optional; enables automatic failover

# ─── AI Coach (OpenRouter) ───────────────────────────────────────────────────
# Coaching is one short line asked often — the one place a $0.01/M model is
# genuinely sufficient. Food scanning stays on OpenAI for vision quality.
# Slugs and prices churn weekly: GET /api/v1/admin/openrouter/models lists the
# cheapest text models live so this can be set from real data.
OPENROUTER_API_KEY=
OPENROUTER_COACH_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_FALLBACK_MODELS_RAW=google/gemini-2.0-flash-001
PUBLIC_APP_URL=https://snapcal.app

# ─── nutrition data ──────────────────────────────────────────────────────────
# Free key: https://api.data.gov/signup/  (same credential works for both)
# Without one, USDA falls back to DEMO_KEY at ~30 req/hour.
DATA_GOV_API_KEY=
USDA_FDC_API_KEY=
OPEN_FOOD_FACTS_UA=SnapCalAI/1.0 (support@snapcal.app)

# ─── Apple ───────────────────────────────────────────────────────────────────
APPLE_BUNDLE_ID=app.snapcal.ios
PRODUCT_MONTHLY=app.snapcal.pro.monthly
PRODUCT_YEARLY=app.snapcal.pro.yearly

# ─── limits & access ─────────────────────────────────────────────────────────
FREE_SCANS_PER_WEEK=2
MAX_UPLOAD_BYTES=1572864

# Comma-separated. Leave EMPTY in production: the iOS app sends no Origin, so an
# empty allowlist blocks browsers without affecting the app.
ALLOWED_ORIGINS=

# Comma-separated user UUIDs allowed to read /api/v1/admin/cost.
ADMIN_USER_IDS=
